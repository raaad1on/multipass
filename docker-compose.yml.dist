# multipass (redirect) — HAProxy L4 SNI → external IP:port
# TCP passthrough, no TLS termination.
#
# ROUTES:
#   *.zone=IP:port          → zone + auto xhttp-*.zone → IP:XHTTP_PORT (default 8443)
#   exact.host=IP:port      → exact SNI only (checked before *.zone)

services:
  multipass:
    image: ghcr.io/raaad1on/multipass:redirect
    container_name: multipass
    restart: unless-stopped
    network_mode: host
    environment:
      LISTEN_PORT: "443"
      XHTTP_PORT: "8443"
      ROUTES: |
        special.example.com=2.2.2.2:443
        *.example.com=1.1.1.1:443
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "1"
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
