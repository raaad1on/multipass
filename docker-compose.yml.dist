# multipass — HAProxy L4 SNI router
# Config is baked into the image. You only need this compose + NODE_HOST.
#
# Routing (TCP passthrough, no TLS termination):
#   xhttp-${NODE_HOST} -> xhttp.sock
#   grpc-${NODE_HOST}  -> grpc.sock
#   *                  -> reality.sock
#
# Start multipass BEFORE Remnawave/Xray so /dev/shm/nginx exists.

services:
  multipass:
    image: ghcr.io/raaad1on/multipass:latest
    container_name: multipass
    restart: unless-stopped
    network_mode: host
    volumes:
      - /dev/shm/nginx:/dev/shm/nginx
    environment:
      NODE_HOST: example.com
      LISTEN_PORT: "443"
      # Optional overrides (defaults: xhttp-${NODE_HOST}, grpc-${NODE_HOST}):
      # XHTTP_SNI: xhttp-example.com
      # GRPC_SNI: grpc-example.com
      XHTTP_SOCK_PATH: /dev/shm/nginx/xhttp.sock
      GRPC_SOCK_PATH: /dev/shm/nginx/grpc.sock
      REALITY_SOCK_PATH: /dev/shm/nginx/reality.sock
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
